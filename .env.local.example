# Base de datos PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/tah_db"

# NextAuth — genera una clave con: openssl rand -base64 32
NEXTAUTH_SECRET="clave-secreta-muy-larga-de-al-menos-32-caracteres"
NEXTAUTH_URL="http://localhost:3000"

# APIs Meteorológicas
OPENWEATHER_API_KEY="tu_clave_openweather_aqui"
WEATHERAPI_KEY="tu_clave_weatherapi_aqui"

# WhatsApp — Evolution API (self-hosted, conexión por QR)
# Local: levanta la instancia con `docker compose up -d`
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="tah-local-dev-key"
EVOLUTION_INSTANCE_NAME="tah-tocancipa"

# Números que reciben las alertas (formato internacional sin '+', separados por coma)
WHATSAPP_RECIPIENTS="573001234567"
